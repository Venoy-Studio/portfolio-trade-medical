:"TKL Indústria e Comércio","categoriaSlug":"descartaveis","subcategoriaSlug":"seringas-e-agulhas","descricaoCurta":"Seringa estéril de 1 mL com agulha fixa, graduação em unidades de insulina e êmbolo de deslizamento suave.","descricaoCompleta":"Seringa descartável de 1 mL para aplicação de insulina, fornecida estéril e de uso único. A agulha fixa 8 x 0,30 mm (30G) reduz o espaço morto entre o corpo da seringa e o canhão, diminuindo a perda de dose. A escala impressa em unidades internacionais facilita a leitura pelo paciente em autoaplicação e pela equipe de enfermagem em ambiente assistencial. O êmbolo possui vedação em elastômero que mantém deslizamento uniforme ao longo de todo o curso.","imagens":[{"url":"/produtos/seringa-de-insulina-tkl-1ml.webp","alt":"Seringa de insulina 1 mL com agulha fixa 8 x 0,30 mm — TKL Indústria e Comércio","principal":true}],"ilustracao":"seringa","especificacoes":[{"rotulo":"Capacidade","valor":"1 mL / 100 UI","grupo":"Dimensões"},{"rotulo":"Agulha","valor":"8 x 0,30 mm (30G)","grupo":"Dimensões"},{"rotulo":"Graduação","valor":"Escala em unidades de insulina (UI)","grupo":"Dimensões"},{"rotulo":"Material do cilindro","valor":"Polipropileno atóxico","grupo":"Materiais"},{"rotulo":"Esterilização","valor":"Óxido de etileno","grupo":"Materiais"},{"rotulo":"Látex","valor":"Não contém látex de borracha natural","grupo":"Materiais"},{"rotulo":"Uso","valor":"Único, descartável","grupo":"Uso"}],"embalagem":{"unidade":"caixa","descricao":"Caixa com 100 unidades","quantidadePorEmbalagem":100,"multiploMinimo":1},"documentos":[{"id":"prd-tkl-ser-ins-1ml-doc-1","titulo":"Ficha técnica","tipo":"ficha_tecnica","url":"/documentos/demonstrativo/seringa-de-insulina-tkl-1ml-ficha_tecnica.pdf","descricao":"PDF"},{"id":"prd-tkl-ser-ins-1ml-doc-2","titulo":"Instruções de uso","tipo":"instrucoes_uso","url":"/documentos/demonstrativo/seringa-de-insulina-tkl-1ml-instrucoes_uso.pdf","descricao":"PDF"}],"regularizacao":{"tipo":"registro","numero":"80142120024