ro aneroide com manômetro de leitura direta e braçadeira adulto reutilizável.","descricaoCompleta":"Esfigmomanômetro aneroide para aferição de pressão arterial pelo método auscultatório. O manômetro possui mostrador de leitura direta com escala de 0 a 300 mmHg e válvula de liberação progressiva acionada com uma das mãos. A braçadeira adulto é reutilizável, com marcação de faixa de circunferência do braço e indicador de posicionamento da artéria.","imagens":[{"url":"/produtos/esfigmomanometro-aneroide-welch-allyn-adulto.webp","alt":"Esfigmomanômetro aneroide adulto com braçadeira — Welch Allyn / Baxter","principal":true}],"ilustracao":"esfigmomanometro","especificacoes":[{"rotulo":"Tipo","valor":"Aneroide, método auscultatório","grupo":"Desempenho"},{"rotulo":"Escala","valor":"0 a 300 mmHg","grupo":"Desempenho"},{"rotulo":"Braçadeira","valor":"Adulto, reutilizável","grupo":"Dimensões"},{"rotulo":"Válvula","valor":"Liberação progressiva","grupo":"Uso"},{"rotulo":"Acompanha","valor":"Bolsa de transporte","grupo":"Uso"}],"embalagem":{"unidade":"unidade","descricao":"Unidade em estojo","quantidadePorEmbalagem":null,"multiploMinimo":null},"documentos":[{"id":"prd-wel-esf-ane-ad-doc-1","titulo":"Ficha técnica","tipo":"ficha_tecnica","url":"/documentos/demonstrativo/esfigmomanometro-aneroide-welch-allyn-adulto-ficha_tecnica.pdf","descricao":"PDF"},{"id":"prd-wel-esf-ane-ad-doc-2","titulo":"Manual do usuário","tipo":"instrucoes_uso","url":"/documentos/demonstrativo/esfigmomanometro-aneroide-welch-allyn-adulto-instrucoes_uso.pdf","descricao":"PDF"}],"regularizacao":{"tipo":"registro","numero":"10345678901","situacao":"vigente","linkConsulta":"https://consultas.anvisa.gov.br/#/saude/produtos/","verificadoEm":null,"detentor":null},"aplicacoes":["Aferição de pressão arterial","Consultório","Ambulatório","Internação"],"tags":["esfigmomanômetro","aneroide","pressão arterial","adulto","braçadeira"],"disponibilidade":"pronta_entrega","status":"publicado","destaque":true,"produtosRel